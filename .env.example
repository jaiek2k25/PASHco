# Server-side NVIDIA Build / NIM API key.
# Recommended for shared or deployed sites. Never prefix this with VITE_.
NVIDIA_API_KEY=

# Optional overrides. Model IDs must be hosted endpoints enabled for your account.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Optional: pin the session signing secret (otherwise generated in server/data).
WESOLVE_SESSION_SECRET=
