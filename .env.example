# Server-side AI key, shared by everyone who uses the site.
# Any OpenAI-compatible provider works. Leave empty to let each visitor paste
# their own key in Settings -> AI (that key stays in their browser).
# Never prefix this with VITE_ — that would ship it to the browser.
NVIDIA_API_KEY=

# Optional overrides. Model IDs must be endpoints enabled for your account.
# DeepSeek example: NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#                   NVIDIA_MODEL=deepseek-ai/deepseek-r1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Optional: pin the session signing secret (otherwise generated in server/data).
WESOLVE_SESSION_SECRET=
