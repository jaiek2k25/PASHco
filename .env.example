# No shared key is needed: every user connects their own in Settings -> AI.
# Signed-in users get theirs stored encrypted on their account.
#
# Optional: run the site on one shared key instead (e.g. a classroom demo).
# Set BOTH variables. Each user's own key still takes precedence.
NVIDIA_API_KEY=
WESOLVE_SHARED_KEY=false

# Optional overrides. Model IDs must be endpoints enabled for your account.
# DeepSeek example: NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#                   NVIDIA_MODEL=deepseek-ai/deepseek-r1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Optional: pin the session signing secret (otherwise generated in server/data).
WESOLVE_SESSION_SECRET=
