# Configure these on the API host's secret/environment-variable panel.
# Never add the real NVIDIA NIM key to the frontend, GitHub Pages build vars,
# a committed .env file, or any VITE_* variable.
PORT=8787
GOOGLE_CLIENT_ID=your-public-web-client-id.apps.googleusercontent.com
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_NIM_CHAT_COMPLETIONS_URL=https://integrate.api.nvidia.com/v1/chat/completions
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_GITHUB_USERNAME.github.io
COURSE_GENERATION_MAX_REQUESTS_PER_HOUR=6
